// Schéma de la base CashPilot.
// Les montants sont en DECIMAL(14,3) : dinars avec 3 décimales (millimes).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id             String    @id
  name           String
  initialBalance Decimal   @db.Decimal(14, 3)
  createdAt      DateTime  @default(now())
  users          User[]
  clients        Client[]
  invoices       Invoice[]
  expenses       Expense[]
  receipts       Receipt[]
  projects       Project[]
}

// Fonctionnalité du secteur « agence digitale » : rentabilité par projet.
model Project {
  id        String   @id
  companyId String
  clientId  String
  name      String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

enum Role {
  OWNER
  FINANCE
  MEMBER
}

model User {
  id           String   @id
  companyId    String
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

enum PartnerKind {
  CLIENT
  SUPPLIER
}

model Client {
  id        String      @id
  companyId String
  kind      PartnerKind @default(CLIENT)
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id])
  invoices  Invoice[]

  @@index([companyId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id        String        @id
  companyId String
  clientId  String
  projectId String?
  number    String
  amount    Decimal       @db.Decimal(14, 3)
  issueDate DateTime      @db.Date
  dueDate   DateTime      @db.Date
  status    InvoiceStatus
  createdAt DateTime      @default(now())
  company   Company       @relation(fields: [companyId], references: [id])
  client    Client        @relation(fields: [clientId], references: [id])
  payments  Payment[]

  @@unique([companyId, number])
}

enum ExpenseCategory {
  SOFTWARE
  FREELANCE
  ADVERTISING
  EQUIPMENT
  RENT
  SALARY
  OTHER
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id              String          @id
  companyId       String
  submittedBy     String
  label           String
  category        ExpenseCategory
  amount          Decimal         @db.Decimal(14, 3)
  date            DateTime        @db.Date
  receiptId       String?
  supplierId      String?
  projectId       String?
  status          ExpenseStatus
  decidedBy       String?
  decidedAt       DateTime?
  rejectionReason String?
  paidBy          String?
  paidAt          DateTime?       @db.Date
  createdAt       DateTime        @default(now())
  company         Company         @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// Justificatif stocké en base : compatible avec un hébergement sans disque (Vercel).
model Receipt {
  id          String   @id
  companyId   String
  fileName    String
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// Un paiement n'est jamais modifié ni supprimé : l'historique est conservé.
model Payment {
  id        String   @id
  invoiceId  String
  amount     Decimal  @db.Decimal(14, 3)
  date       DateTime @db.Date
  reversalOf String? // contre-passation : id du paiement corrigé
  reason     String?
  createdAt  DateTime @default(now())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}
